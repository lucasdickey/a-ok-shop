# Stripe: checkout, game discount codes, and catalog prices
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Tax - set to 'true' only if you have registered tax locations in the Stripe Dashboard
# See: https://dashboard.stripe.com/tax/registrations
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Site URL (important for Stripe redirects)
SITE_URL=https://your-production-domain.com

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Owner order alerts (sent from the Stripe webhook via Resend so you can place
# the print-on-demand order). Customers get Stripe's own payment receipt.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=you@example.com
# Optional; the sending domain must be verified in Resend
ORDER_EMAIL_FROM=A-OK <orders@a-ok.ai>

# PostHog product analytics (public project key, safe in the browser). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=

# Redis: checkout sessions, rate limits and Chaos Monkey "Print this" requests.
REDIS_URL=

# Chaos Monkey "Print this" requests.
# A random secret used to scramble visitor IP addresses before they're stored.
PRINT_REQUEST_SECRET=
# Opens the owner-only ranked list at /api/print-requests/top?token=<this>. Leave empty to turn it off.
PRINT_REQUESTS_ADMIN_TOKEN=

# WebMCP: the shop's tools for in-browser AI agents (components/WebMcpTools.tsx).
# Chrome and Edge only run WebMCP for visitors on sites in their Origin Trials. Register
# your domain at https://developer.chrome.com/origintrials and the Edge origin trials page,
# then list the token(s) here, comma-separated. Leave empty to skip the trial tags.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKENS=
