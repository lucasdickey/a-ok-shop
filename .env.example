# Shopify API Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your-storefront-api-token

# Stripe Configuration (catalog + monthly deals)
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook signing secrets. At least one is required or orders are never
# processed. _1 and _2 support two Stripe destinations on the same endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_WEBHOOK_SECRET_1=whsec_...
# STRIPE_WEBHOOK_SECRET_2=whsec_...

# Stripe Tax - set to 'true' only if you have registered tax locations in the Stripe Dashboard
# See: https://dashboard.stripe.com/tax/registrations
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Order emails (Resend). WITHOUT RESEND_API_KEY NO CONFIRMATION EMAIL IS SENT.
RESEND_API_KEY=re_your-resend-api-key
# Must be a domain verified in Resend
ORDER_EMAIL_FROM=A-OK Shop <orders@a-ok.shop>
# Operator address that receives a "new order to fulfill" alert for every paid
# order. Set this so orders cannot go unnoticed.
ORDER_NOTIFICATION_EMAIL=fulfillment@a-ok.shop

# Optional: shares Stripe webhook de-duplication across serverless instances.
# Without it, de-duplication is per-instance only.
REDIS_URL=redis://localhost:6379

# Site URL (important for Stripe redirects)
SITE_URL=https://your-production-domain.com

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
